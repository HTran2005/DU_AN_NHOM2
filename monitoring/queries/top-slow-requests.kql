// ============================================================
// KQL: Top requests chậm nhất (cần App Insights gắn vào PHP)
// ============================================================
// Chạy trong: Log Analytics workspace (law-tripto) -> Logs
// Schema: workspace-based App* tables (PascalCase columns)
// Nếu chạy từ blade Application Insights, portal tự dịch sang tên cổ
// (requests, exceptions, name, problemId...) nên cũng hoạt động.
// ============================================================

// --- 1. TOP 20 request chậm nhất ---
AppRequests
| where TimeGenerated > ago(24h)
| project TimeGenerated, Name, DurationMs, Success, ResultCode, Url
| order by DurationMs desc
| take 20

// --- 2. Requests thất bại (HTTP 5xx) ---
AppRequests
| where TimeGenerated > ago(24h)
| where ResultCode startswith "5"
| summarize Count = count() by ResultCode, Name
| order by Count desc

// --- 3. Hiệu suất theo endpoint ---
AppRequests
| where TimeGenerated > ago(24h)
| summarize
    AvgDuration = avg(DurationMs),
    MaxDuration = max(DurationMs),
    P95Duration = percentile(DurationMs, 95),
    P99Duration = percentile(DurationMs, 99),
    TotalRequests = count(),
    FailedRequests = countif(Success == false)
  by Name
| order by AvgDuration desc

// --- 4. Số lượng request theo giờ ---
AppRequests
| where TimeGenerated > ago(7d)
| summarize RequestCount = count() by bin(TimeGenerated, 1h)
| render timechart

// --- 5. Lỗi exception từ PHP backend ---
// Lưu ý: cột Type trong AppExceptions chứa tên bảng ("AppExceptions"),
// loại exception thật nằm ở cột OuterType.
AppExceptions
| where TimeGenerated > ago(24h)
| project TimeGenerated, OuterType, Method, ProblemId, OuterMessage
| order by TimeGenerated desc
