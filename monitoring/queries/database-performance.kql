// ============================================================
// KQL: Database performance tracking (MySQL queries)
// ============================================================
// Chạy trong: Log Analytics workspace (law-tripto) -> Logs
// Schema: workspace-based App* tables (PascalCase columns)
// Nếu chạy từ blade Application Insights, portal tự dịch sang tên cổ
// (dependencies, name, duration...) nên cũng hoạt động.
// ============================================================

// --- 1. Tổng quan dependencies (MySQL queries từ PHP) ---
AppDependencies
| where TimeGenerated > ago(24h)
| where Type == "SQL"
| summarize
    AvgDuration = avg(DurationMs),
    MaxDuration = max(DurationMs),
    TotalCalls = count()
  by Target
| order by AvgDuration desc

// --- 2. Slow queries (> 1 giây) ---
AppDependencies
| where TimeGenerated > ago(24h)
| where Type == "SQL"
| where DurationMs > 1000
| project TimeGenerated, Target, DurationMs, Data
| order by DurationMs desc

// --- 3. Lỗi kết nối database ---
AppDependencies
| where TimeGenerated > ago(24h)
| where Type == "SQL"
| where Success == false
| project TimeGenerated, Target, DurationMs, ResultCode
| order by TimeGenerated desc

// --- 4. Số lượng kết nối theo giờ ---
AppDependencies
| where TimeGenerated > ago(7d)
| where Type == "SQL"
| summarize ConnectionCount = count() by bin(TimeGenerated, 1h)
| render timechart
