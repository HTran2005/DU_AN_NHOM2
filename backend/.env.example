REDIS_HOST=
REDIS_PORT=10000
REDIS_PASSWORD=

# For Azure Managed Redis, enable TLS
REDIS_TLS=true

# TTL cho cache yêu thích (giây) - mặc định 600s nếu không đặt
REDIS_FAVORITE_TTL=600

# Chu kỳ đồng bộ Redis -> Database (giây) cho chức năng yêu thích.
# Các thao tác bấm ❤️ chỉ ghi vào Redis trước; DB chỉ được ghi lại mỗi
# REDIS_FAVORITE_FLUSH_SECONDS giây một lần (write-behind / batch sync).
# Mặc định 10s nếu không đặt.
REDIS_FAVORITE_FLUSH_SECONDS=10

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Azure Event Grid - Topic đăng nhập (LoginResult)
# Endpoint: lấy từ Azure Portal (Event Grid Topic -> Overview) hoặc az eventgrid topic show
EVENTGRID_LOGIN_TOPIC_ENDPOINT=https://tripto-login-topic.southeastasia-1.eventgrid.azure.net/api/events
# Key: lấy từ Azure Portal (Event Grid Topic -> Access keys) hoặc az eventgrid topic key list
EVENTGRID_LOGIN_TOPIC_KEY=

# (Function App) Connection string cho Storage dùng để LƯU lịch sử đăng nhập
# LoginEventHandler ghi event LoginResult vào container "login-events".
# Nếu để trống, Function tự fallback sang VISIT_STORAGE_CONNECTION_STRING /
# AzureWebJobsStorage.
LOGIN_EVENT_STORAGE_CONNECTION_STRING=