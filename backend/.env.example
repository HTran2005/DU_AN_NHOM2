REDIS_HOST=
REDIS_PORT=10000
REDIS_PASSWORD=

# For Azure Managed Redis, enable TLS
REDIS_TLS=true

# TTL cho cache yêu thích (giây) - mặc định 600s nếu không đặt
REDIS_FAVORITE_TTL=600

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Azure Event Grid - Topic đăng nhập (User.Login)
# Endpoint: lấy từ Azure Portal (Event Grid Topic -> Overview) hoặc az eventgrid topic show
EVENTGRID_LOGIN_TOPIC_ENDPOINT=https://tripto-login-topic.southeastasia-1.eventgrid.azure.net/api/events
# Key: lấy từ Azure Portal (Event Grid Topic -> Access keys) hoặc az eventgrid topic key list
EVENTGRID_LOGIN_TOPIC_KEY=